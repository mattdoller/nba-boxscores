# Optional: port for the local server (defaults to 3000)
# PORT=3000
# NBA_CACHE_DB=data/nba-cache.sqlite
# Pause before retrying a failed stats.nba.com request (defaults to 1000)
# NBA_RETRY_DELAY_MS=1000
# Never ask stats.nba.com; serve only what's cached (same as bin/server --offline)
# NBA_OFFLINE=1
